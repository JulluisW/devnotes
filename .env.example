# 📘 Day 12: the list of environment variables DevNotes needs.
# This file IS committed to git (no real secrets in it). To run the app:
#   cp .env.example .env.local     then put real values in .env.local
# The rules for each value live in src/lib/env-schema.ts.

# The public address of the site (canonical URLs, sitemap, RSS, Open Graph).
# Read when you run `next build`, so set it before building.
SITE_URL=http://localhost:3005

# Shared secret for the CMS webhook (Day 8). At least 16 characters.
CMS_WEBHOOK_SECRET=change-me-to-a-long-random-string
